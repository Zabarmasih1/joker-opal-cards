<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/accent_gold</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Numeric" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/accent_gold</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="backgroundTint">@color/btn_primary_fill</item>
        <item name="cornerRadius">18dp</item>
        <item name="elevation">10dp</item>
        <item name="rippleColor">@color/ripple_on_gold</item>
        <item name="strokeColor">@color/btn_primary_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/btn_primary_text</item>
        <item name="iconSize">24dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface_slot</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">@color/ripple_on_dark</item>
        <item name="strokeColor">@color/stroke_gold</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/accent_gold</item>
        <item name="iconSize">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/secondary_crimson</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">4dp</item>
        <item name="rippleColor">@color/ripple_on_gold</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.App.Button.IconOnly" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/surface_slot</item>
        <item name="rippleColor">@color/ripple_on_dark</item>
        <item name="strokeColor">@color/stroke_gold</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">24dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="Widget.App.Card.Surface" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card_translucent</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">12dp</item>
        <item name="strokeColor">@color/stroke_gold</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.App.Card.Slot" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_slot</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider_gold</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
