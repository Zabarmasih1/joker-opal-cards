<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JokerOpalCards" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_gold</item>
        <item name="colorOnPrimary">@color/text_on_gold</item>
        <item name="colorPrimaryContainer">@color/surface_raised</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/primary_opal</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorError">@color/secondary_crimson</item>
        <item name="colorOnError">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke_gold</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.AlertDialog</item>
    </style>

    <style name="Theme.JokerOpalCards.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/accent_gold</item>
        <item name="colorOnPrimary">@color/text_on_gold</item>
        <item name="colorSecondary">@color/primary_opal</item>
        <item name="colorError">@color/secondary_crimson</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface_card</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:windowMinWidthMajor">94%</item>
        <item name="android:windowMinWidthMinor">94%</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.App.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent_gold</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
    </style>
</resources>
