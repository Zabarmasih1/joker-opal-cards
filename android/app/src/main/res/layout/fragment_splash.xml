<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <ImageView
        android:id="@+id/image_splash_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_splash_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_splash_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_splash_glow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/glow_gold_soft"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/layout_card_fan"
        app:layout_constraintEnd_toEndOf="@id/layout_card_fan"
        app:layout_constraintStart_toStartOf="@id/layout_card_fan"
        app:layout_constraintTop_toTopOf="@id/layout_card_fan" />

    <FrameLayout
        android:id="@+id/layout_card_fan"
        android:layout_width="260dp"
        android:layout_height="@dimen/splash_card_height"
        android:clipChildren="false"
        app:layout_constraintBottom_toTopOf="@id/text_splash_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/image_card_left"
            android:layout_width="@dimen/splash_card_width"
            android:layout_height="@dimen/splash_card_height"
            android:layout_gravity="center"
            android:background="@drawable/frame_card_gold"
            android:contentDescription="@string/cd_joker_face"
            android:padding="@dimen/space_sm"
            android:rotation="-11"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_joker_card"
            android:translationX="-36dp" />

        <ImageView
            android:id="@+id/image_card_right"
            android:layout_width="@dimen/splash_card_width"
            android:layout_height="@dimen/splash_card_height"
            android:layout_gravity="center"
            android:background="@drawable/frame_card_gold"
            android:contentDescription="@string/cd_joker_face"
            android:padding="@dimen/space_sm"
            android:rotation="11"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_joker_card"
            android:translationX="36dp" />

        <ImageView
            android:id="@+id/image_card_center"
            android:layout_width="@dimen/splash_card_width"
            android:layout_height="@dimen/splash_card_height"
            android:layout_gravity="center"
            android:background="@drawable/frame_card_gold"
            android:contentDescription="@string/cd_joker_face"
            android:elevation="8dp"
            android:padding="@dimen/space_sm"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_joker_card" />

        <ImageView
            android:id="@+id/image_card_opal"
            android:layout_width="@dimen/splash_opal_size"
            android:layout_height="@dimen/splash_opal_size"
            android:layout_gravity="center"
            android:alpha="0.95"
            android:elevation="9dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_opal_violet" />

        <View
            android:id="@+id/view_splash_sheen"
            android:layout_width="@dimen/sheen_width"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/sheen_gold_sweep"
            android:elevation="10dp"
            android:importantForAccessibility="no"
            android:rotation="18" />

    </FrameLayout>

    <TextView
        android:id="@+id/text_splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="@dimen/space_xxl"
        android:shadowColor="#996E3BB8"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="14"
        android:text="@string/splash_title"
        android:textAppearance="@style/TextAppearance.App.Display"
        app:layout_constraintBottom_toTopOf="@id/text_splash_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_card_fan" />

    <TextView
        android:id="@+id/text_splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.9"
        android:layout_marginTop="10dp"
        android:letterSpacing="0.22"
        android:text="@string/splash_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/progress_splash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_splash_title" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_splash"
        android:layout_width="@dimen/splash_progress_width"
        android:layout_height="wrap_content"
        android:contentDescription="@string/splash_progress_cd"
        android:indeterminate="true"
        android:layout_marginTop="@dimen/space_xxl"
        app:indicatorColor="@color/accent_gold"
        app:layout_constraintBottom_toTopOf="@id/text_splash_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_splash_subtitle"
        app:trackColor="@color/surface_slot"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp" />

    <TextView
        android:id="@+id/text_splash_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:layout_marginTop="@dimen/space_md"
        android:letterSpacing="0.18"
        android:text="@string/splash_loading"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_splash" />

    <TextView
        android:id="@+id/text_splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:letterSpacing="0.12"
        android:text="@string/splash_footer"
        android:textColor="@color/text_faint"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
