<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_art_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.58" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_sheet_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.46" />

    <ImageView
        android:id="@+id/image_menu_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toTopOf="@id/guideline_art_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_menu_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_menu_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/image_menu_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/image_menu_card"
        android:layout_width="@dimen/menu_card_width"
        android:layout_height="@dimen/menu_card_height"
        android:layout_marginStart="26dp"
        android:background="@drawable/frame_card_gold"
        android:contentDescription="@string/cd_menu_card"
        android:padding="@dimen/space_sm"
        android:rotation="-8"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_joker_card"
        app:layout_constraintBottom_toTopOf="@id/guideline_sheet_top"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/image_menu_opal"
        android:layout_width="@dimen/menu_opal_size"
        android:layout_height="@dimen/menu_opal_size"
        android:layout_marginEnd="34dp"
        android:layout_marginBottom="36dp"
        android:alpha="0.95"
        android:contentDescription="@string/cd_menu_opal"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_opal_gold"
        app:layout_constraintBottom_toTopOf="@id/guideline_sheet_top"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_chips_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:accessibilityLiveRegion="polite"
        app:cardBackgroundColor="@color/surface_badge"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/stroke_gold"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="@dimen/icon_medium"
                android:layout_height="@dimen/icon_medium"
                android:contentDescription="@string/cd_chip_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chip" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_menu_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Numeric"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/menu_chips_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/layout_menu_sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/sheet_gold_frame"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_sheet_top">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/grab_pill"
            android:importantForAccessibility="no" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_xl"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_menu_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/menu_title"
                    android:textAppearance="@style/TextAppearance.App.Headline" />

                <TextView
                    android:id="@+id/text_menu_chapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp" />

                <com.jokeropal.cards.core.ui.ChapterProgressView
                    android:id="@+id/view_chapter_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <LinearLayout
                    android:id="@+id/layout_menu_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.jokeropal.cards.core.ui.StatCardView
                        android:id="@+id/stat_menu_cascade"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.jokeropal.cards.core.ui.StatCardView
                        android:id="@+id/stat_menu_seals"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1" />

                </LinearLayout>

                <TextView
                    android:id="@+id/text_menu_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="@string/menu_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_play"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cta_height"
                    android:text="@string/cta_play"
                    app:icon="@drawable/ic_play" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_seals"
                        style="@style/Widget.App.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_secondary_height"
                        android:layout_weight="1"
                        android:text="@string/cta_seals"
                        app:icon="@drawable/ic_seal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_settings"
                        style="@style/Widget.App.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_secondary_height"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="@string/cta_settings"
                        app:icon="@drawable/ic_settings" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
