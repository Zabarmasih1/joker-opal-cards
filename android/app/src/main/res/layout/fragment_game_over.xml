<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_over_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <ImageView
        android:id="@+id/image_result_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_result_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_result_scrim_win"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl">

            <FrameLayout
                android:id="@+id/layout_result_hero"
                android:layout_width="240dp"
                android:layout_height="200dp"
                android:layout_marginTop="56dp">

                <View
                    android:id="@+id/view_result_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/glow_gold_soft"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/image_result_hero"
                    android:layout_width="@dimen/seal_hero_size"
                    android:layout_height="@dimen/seal_hero_size"
                    android:layout_gravity="center"
                    android:contentDescription="@string/result_seal_cd"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_seal_gold" />

            </FrameLayout>

            <TextView
                android:id="@+id/text_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="@string/result_title_win"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textColor="@color/accent_gold"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/text_result_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_result"
                style="@style/Widget.App.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.jokeropal.cards.core.ui.StatCardView
                            android:id="@+id/stat_result_score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <com.jokeropal.cards.core.ui.StatCardView
                            android:id="@+id/stat_result_cages"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1" />

                        <com.jokeropal.cards.core.ui.StatCardView
                            android:id="@+id/stat_result_cascade"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1" />

                    </LinearLayout>

                    <View
                        android:id="@+id/view_result_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/divider_line"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:id="@+id/layout_result_reward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_medium"
                            android:layout_height="@dimen/icon_medium"
                            android:contentDescription="@string/cd_chip_icon"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_chip" />

                        <TextView
                            android:id="@+id/text_result_reward"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:textColor="@color/accent_gold"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_play_again"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:text="@string/cta_play_again"
                app:icon="@drawable/ic_replay" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_result_menu"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_secondary_height"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="36dp"
                android:text="@string/cta_menu"
                app:icon="@drawable/ic_home" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
